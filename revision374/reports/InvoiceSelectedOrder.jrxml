	<parameter name="OrderId" class="java.util.Collection">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT tor.*,tori.*,tori.id as OrderItemId,tui.*,tcm.Country as ShippCountry,tsm.Name as ShippState,tbm.*,tsm1.Name as BillState,tcm1.Country as BillCountry FROM tblOrder tor
Left Join tblOrderItem tori on tor.id = tori.OrderId 
LEFT JOIN tbluserinformation tui ON tui.id = tor.CustomerId
Left Join tblcountrymgmt tcm ON tor.ShippidCountry = tcm.id 
LEFT JOIN tblcountrystatemgmt tsm ON tor.ShippidState = tsm.id 
LEFT JOIN tblBillingAddress tbm ON tor.BillingAddressId = tbm.id
LEFT JOIN tblcountrystatemgmt tsm1 ON tbm.idState = tsm1.id 
LEFT JOIN tblcountrymgmt tcm1 ON tbm.idCountry = tcm1.id
WHERE  tor.OrderStatusId != 1 and tor.OrderStatusId != 4 and
$X{IN,tor.id, OrderId }
group by tor.id]]>
	</queryString>
